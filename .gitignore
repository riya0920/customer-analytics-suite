# Generated data -- every file here is reproducible by running the project's
# own generator with its fixed seed. Committing it would add megabytes and
# invite the reader to trust a file instead of the script that made it.
# Anchored to the repo root: a bare `data/` also matched nested source folders
# named data (frontend/src/data, java-api/.../data, frontend/public/data), so
# only the top-level generated dir is ignored here.
/data/
bi_export/
*.parquet
*.npy
*.db
*.db-wal
*.db-shm
*.csv.gz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large regenerable artifacts
out/*.pkl
out/*.log
# timing artifact; varies per run, numbers live in the README
out/bench_spark.json
data/*.duckdb
dbt/target/
dbt/logs/

# Databricks upload artifacts (regenerate: python databricks/export_raw_csv.py)
databricks/data/

# generated Plotly view (regenerate with python -m src.plotly_view)
out/attribution_plotly.html
