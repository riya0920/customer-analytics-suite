# Generated data -- every file here is reproducible by running the project's
# own generator with its fixed seed. Committing it would add megabytes and
# invite the reader to trust a file instead of the script that made it.
data/
# ...except the dashboard's static data assets: the deployed React app in
# frontend/ needs these exported CSVs bundled, so re-include that one folder.
!frontend/public/data/
bi_export/
*.parquet
*.npy
*.db
*.db-wal
*.db-shm
*.csv.gz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large regenerable artifacts
out/*.pkl
out/*.log
# timing artifact; varies per run, numbers live in the README
out/bench_spark.json
data/*.duckdb
dbt/target/
dbt/logs/

# Databricks upload artifacts (regenerate: python databricks/export_raw_csv.py)
databricks/data/
