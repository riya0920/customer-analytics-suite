# Generated data -- every file here is reproducible by running the project's
# own generator with its fixed seed. Committing it would add megabytes and
# invite the reader to trust a file instead of the script that made it.
data/
# ...except anything under the React app in frontend/: it has both a source
# module folder (src/data/) and bundled data assets (public/data/) that the
# bare data/ rule above would otherwise swallow. Re-include every data/ dir
# nested under frontend/.
!frontend/**/data/
bi_export/
*.parquet
*.npy
*.db
*.db-wal
*.db-shm
*.csv.gz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large regenerable artifacts
out/*.pkl
out/*.log
# timing artifact; varies per run, numbers live in the README
out/bench_spark.json
data/*.duckdb
dbt/target/
dbt/logs/

# Databricks upload artifacts (regenerate: python databricks/export_raw_csv.py)
databricks/data/
